def find_task(task_id):
    """Return (start, notes, end, extras) for a task id, searching every session."""
    start = end = None
    notes, scopes, waits, runs = [], [], [], []
    for ev in all_events():
        if ev.get("type") == "start" and ev.get("id") == task_id:
            start = ev
        elif ev.get("type") == "note" and ev.get("task") == task_id:
            notes.append(ev)
        elif ev.get("type") == "scope" and ev.get("task") == task_id:
            scopes.append(ev)
        elif ev.get("type") == "wait" and ev.get("task") == task_id:
            waits.append(ev)
        elif ev.get("type") == "run" and ev.get("task") == task_id:
            runs.append(ev)
        elif ev.get("type") == "end" and ev.get("task") == task_id:
            end = ev
    return start, notes, end, {"scopes": scopes, "waits": waits, "runs": runs}


def render_task(start, notes, end, as_json=False, extras=None):
    extras = extras or {"scopes": [], "waits": [], "runs": []}
    if as_json:
        for ev in ([start] if start else []) + notes + extras["scopes"] \
                + extras["waits"] + extras["runs"] + ([end] if end else []):
            print(json.dumps(ev, ensure_ascii=False, indent=2))
        return
    out = []
    title = (start or {}).get("title") or (end or {}).get("task") or "?"
    status = (end or {}).get("status") or "in progress"
    out.append("TASK %s  [%s]" % ((start or end or {}).get("id", "?"), status))
    out.append("  title:    %s" % title)
    out.append("  agent:    %s   session: %s" % ((start or end or {}).get("agent", "?"),
                                                (start or end or {}).get("session", "?")))
    out.append("  started:  %s" % ((start or {}).get("ts", "?")))
    if end:
        out.append("  ended:    %s   (%s)" % (end.get("ts", "?"), fmt_duration(end.get("duration_s"))))
    for key, label in (("goal", "goal"), ("summary", "summary"), ("impact", "impact")):
        src = start if key == "goal" else end
        val = (src or {}).get(key)
        if val:
            out.append("  %s: %s" % (label, val))
    for key, label in (("plan", "plan"), ("accept", "accept"), ("outs", "out of scope"),
                       ("done", "done"), ("problems", "problems"), ("verify", "verify"),
                       ("metrics", "metrics"), ("next", "next")):
        items = (start or {}).get(key) or (end or {}).get(key) or []
        if items:
            out.append("  %s:" % label)
            out.extend("    - %s" % i for i in items)
    for key, label in (("scope", "scope"), ("tags", "tags"), ("changes", "changes"),
                       ("commits", "commits"), ("lessons", "lessons"), ("refs", "refs")):
        items = (start or {}).get(key) or (end or {}).get(key) or []
        if items:
            out.append("  %s: %s" % (label, ", ".join(items)))
    if notes:
        out.append("  notes (%d):" % len(notes))
        for n in notes:
            out.append("    [%s] %s" % (n.get("kind", "note"), n.get("text", "")))
            if n.get("next"):
                out.append("      next: %s" % n["next"])
            for d in (n.get("detail") or []):
                out.append("      - %s" % d)
            if n.get("where"):
                out.append("      where: %s" % ", ".join(n["where"]))
    for sc in extras["scopes"]:
        out.append("  scope +%s (%s)" % (", ".join(sc.get("add") or []), sc.get("why", "")))
    for r in extras["runs"]:
        flag = " LATE +%ds" % r["late_s"] if r.get("late_s") else ""
        out.append("  run %s: %s, exit %s%s" % (r.get("cmd", ""),
                  fmt_duration(r.get("actual_s")), r.get("exit", "?"), flag))
    if end and end.get("score") is not None:
        out.append("  score: %d (nhịp %s · scope %s · kết thúc %s · mở %s)"
                   % (end["score"], end.get("cadence", "?"), end.get("scope_pts", "?"),
                      end.get("close_pts", "?"), end.get("open_pts", "?")))
        if end.get("gate"):
            out.append("  gate: %s" % "; ".join(end["gate"]))
    print("\n".join(out))


