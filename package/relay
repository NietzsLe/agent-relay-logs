#!/usr/bin/env python3
"""relay — per-session work log for multiple agents (schema v3).

Layout (v3):
  data/YYYY-MM-DD.jsonl   every event of that UTC day, all sessions, one file
  cursors/<session>.json  per-session read cursor: {data file -> byte offset}
  data/legacy/            per-session files from v1/v2, kept after migration

One JSON object per line. Event types:

  join  — session profile (agent, model, host, cwd, branch, head…)
  start — a task opens: what will be done, how, and how "done" is judged
  note  — while working: progress / problem / decision / result / blocker
  end   — a task closes: what was done, problems, verification, next steps

Every event type carries detail, because a log that only says "task X started"
tells the next session nothing useful. See README.md next to this file.
Python standard library only.
"""
import argparse
import json
import os
import platform
import random
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone

VERSION = "3.0.0"
SCHEMA = 3
ROOT = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(ROOT, "data")
CURSORS = os.path.join(ROOT, "cursors")
LEGACY = os.path.join(DATA, "legacy")
DAY_RE = re.compile(r"^\d{4}-\d{2}-\d{2}\.jsonl$")
STALE_H = float(os.environ.get("RELAY_STALE_HOURS", "12"))
CAP = 25          # maximum lines printed by one sync
RECENT_DONE = 10  # first sync in a session: number of recently finished items
MAX_LINE = 8000   # hard cap for one event line (JSON must stay valid)
NOTE = "[relay] log is only relatively complete — verify git/real state before relying on it"

KINDS = ("progress", "problem", "decision", "result", "blocker", "question")

# field -> (max items, max chars per item) for list fields
LIST_LIMITS = {
    "plan": (12, 300), "accept": (8, 300), "outs": (8, 300), "scope": (30, 200),
    "tags": (12, 60), "refs": (20, 200), "detail": (20, 300), "done": (20, 300),
    "problems": (20, 400), "verify": (12, 300), "metrics": (12, 200),
    "changes": (40, 200), "commits": (10, 60), "next": (12, 300), "lessons": (8, 40),
}
TEXT_LIMITS = {
    "title": 120, "goal": 600, "text": 600, "summary": 1000, "impact": 600,
}


# --------------------------------------------------------------------------- utils
def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def age_h(ts):
    t = datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    return (datetime.now(timezone.utc) - t).total_seconds() / 3600


def rid():
    return time.strftime("%y%m%d-%H%M%S", time.gmtime()) + "-" + "%03x" % random.randrange(4096)


def git(*a):
    try:
        return subprocess.run(["git", *a], capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""


def clip_text(v, n):
    """Truncate but keep the marker explicit, and keep newlines (detail matters)."""
    v = (v or "").rstrip()
    if len(v) <= n:
        return v
    return v[: max(0, n - 20)].rstrip() + " …(+%d ký tự)" % (len(v) - n)


def clip_list(items, count, width):
    out = []
    for item in items:
        item = clip_text(item, width)
        if item:
            out.append(item)
    if len(out) > count:
        out = out[:count] + ["…(+%d mục)" % (len(out) - count)]
    return out


def smart_split(s):
    """Split on commas that are not inside brackets or quotes.

    Plain `s.split(",")` destroys paths and prose like
    "repo (new, commit c4675a6)" — that bug is why this exists.
    """
    out, buf, depth, quote = [], [], 0, ""
    for ch in s or "":
        if quote:
            buf.append(ch)
            if ch == quote:
                quote = ""
            continue
        if ch in "\"'":
            quote = ch
            buf.append(ch)
            continue
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth = max(0, depth - 1)
        if ch == "," and depth == 0:
            out.append("".join(buf).strip())
            buf = []
            continue
        buf.append(ch)
    if buf:
        out.append("".join(buf).strip())
    return [x for x in out if x]


def flat(values, split=True):
    """Flatten repeatable CLI options into one list."""
    out = []
    for v in values or []:
        out.extend(smart_split(v) if split else [v])
    return [x for x in out if x]


def one(text, limit=160):
    """Render multi-line text on a single line for compact output."""
    text = " ".join((text or "").split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


# --------------------------------------------------------------------------- storage
def day_stamp(ts=None):
    """UTC day of an event timestamp (or today)."""
    if ts:
        return ts[:10]
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


def day_path(day=None):
    return os.path.join(DATA, "%s.jsonl" % (day or day_stamp()))


def is_day_file(name):
    return bool(DAY_RE.match(name))


def cursor_path(sid):
    return os.path.join(CURSORS, sid + ".json")


def data_files():
    """Day files first, then legacy per-session files that still need migrating."""
    try:
        names = sorted(os.listdir(DATA))
    except OSError:
        return []
    days = [n for n in names if is_day_file(n)]
    legacy = [n for n in names if n.endswith(".jsonl") and not is_day_file(n)]
    return days + legacy


def legacy_files():
    try:
        return sorted(n for n in os.listdir(DATA) if n.endswith(".jsonl") and not is_day_file(n))
    except OSError:
        return []


def write_event(ev, day=None):
    """Append one event to a day file. The line is always valid JSON."""
    os.makedirs(DATA, exist_ok=True)
    line = json.dumps(ev, ensure_ascii=False)
    if len(line) + 1 > MAX_LINE:
        ev = shrink(ev)
        line = json.dumps(ev, ensure_ascii=False)
        if len(line) + 1 > MAX_LINE:
            keep = {k: ev[k] for k in ("id", "ts", "type", "v", "session", "agent", "task")
                    if k in ev}
            keep["trimmed"] = True
            keep["title"] = clip_text(ev.get("title", ""), 120)
            keep["summary"] = clip_text(ev.get("summary", ""), 200)
            keep["text"] = clip_text(ev.get("text", ""), 200)
            line = json.dumps(keep, ensure_ascii=False)
    # one write() call with O_APPEND: concurrent sessions never interleave a line
    fd = os.open(day_path(day), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, (line + "\n").encode())
    finally:
        os.close(fd)


def append(sid, ev):
    """Append one event to today's file."""
    write_event(ev)


def shrink(ev):
    """Reduce an oversized event while keeping it informative and valid."""
    ev = dict(ev)
    for key in LIST_LIMITS:
        if isinstance(ev.get(key), list) and len(ev[key]) > 1:
            ev[key] = ev[key][:1]
    for key in TEXT_LIMITS:
        if key in ev:
            ev[key] = clip_text(ev[key], 200)
    ev["trimmed"] = True
    return ev


def read_file(fn, offset=0):
    """Return (events, new_offset); only complete newline-terminated lines are read."""
    evs = []
    try:
        with open(os.path.join(DATA, fn), "rb") as f:
            f.seek(offset)
            raw = f.read()
    except OSError:
        return evs, offset
    end = raw.rfind(b"\n") + 1
    for ln in raw[:end].splitlines():
        try:
            evs.append(json.loads(ln))
        except ValueError:
            pass
    return evs, offset + end


def all_events():
    out = []
    for fn in data_files():
        evs, _ = read_file(fn)
        out.extend(evs)
    return out


def session_events(sid):
    """Every event written by this session, across all day files."""
    return [e for e in all_events() if e.get("session") == sid]


def migrate(dry_run=False):
    """Move v1/v2 per-session files into the day files.

    The original files are kept in data/legacy/ — nothing is deleted.
    """
    report = []
    for name in legacy_files():
        events, _ = read_file(name)
        by_day = {}
        for e in events:
            by_day.setdefault(day_stamp(e.get("ts")), []).append(e)
        for day, evs in by_day.items():
            existing, _ = read_file("%s.jsonl" % day)
            known = {e.get("id") for e in existing}
            fresh = [e for e in evs if e.get("id") not in known]
            for e in fresh:
                if not dry_run:
                    write_event(e, day)
            report.append("%s -> %s.jsonl: %d sự kiện (%d mới)"
                          % (name, day, len(evs), len(fresh)))
        if not dry_run:
            os.makedirs(LEGACY, exist_ok=True)
            dest = os.path.join(LEGACY, name)
            if not os.path.exists(dest):
                shutil.move(os.path.join(DATA, name), dest)
    return report


def open_tasks(evs):
    starts = {e["id"]: e for e in evs if e.get("type") == "start"}
    for e in evs:
        if e.get("type") == "end":
            starts.pop(e.get("task"), None)
    return list(starts.values())


def overlap(a, b):
    return any(x == y or x.startswith(y.rstrip("/") + "/") or y.startswith(x.rstrip("/") + "/")
               for x in a for y in b)


def who(e):
    return "%s:%s" % (e.get("agent", "?"), e.get("session", "?")[:8])


# --------------------------------------------------------------------------- session
def explicit_agent(args):
    if getattr(args, "agent", None):
        return args.agent
    return os.environ.get("RELAY_AGENT") or None


def session_agent(sid):
    """Agent name recorded when this session joined — so later commands need not repeat it."""
    for e in session_events(sid):
        if e.get("type") == "join":
            return e.get("agent") or None
    return None


def resolve_agent(sid, args):
    return explicit_agent(args) or session_agent(sid) or "agent"


def session_id(args):
    sid = args.session or os.environ.get("RELAY_SESSION")
    new = False
    if not sid:
        sid = "%s-%s" % (explicit_agent(args) or "agent", rid())
        new = True
    return sid, new


def ensure_join(sid, args):
    """Write the session profile line for a new session. Return True if new."""
    if any(e.get("type") == "join" for e in session_events(sid)):
        return False
    dirty = len(git("status", "--porcelain").splitlines())
    gd, gc = git("rev-parse", "--git-dir"), git("rev-parse", "--git-common-dir")
    cwd = os.getcwd()
    append(sid, {
        "id": rid(), "ts": now(), "type": "join", "v": SCHEMA, "session": sid,
        "agent": explicit_agent(args) or "agent", "model": args.model or "",
        "user": os.environ.get("USER", ""), "host": platform.node(), "pid": os.getppid(),
        "cwd": cwd, "project": os.path.basename(cwd), "branch": git("rev-parse", "--abbrev-ref", "HEAD"),
        "head": git("rev-parse", "--short", "HEAD"), "worktree": bool(gd and gd != gc), "dirty": dirty,
    })
    return True


def base(sid, args, typ):
    return {"id": rid(), "ts": now(), "type": typ, "v": SCHEMA, "session": sid,
            "agent": resolve_agent(sid, args), "cwd": os.getcwd(),
            "branch": git("rev-parse", "--abbrev-ref", "HEAD"),
            "head": git("rev-parse", "--short", "HEAD")}


# --------------------------------------------------------------------------- rendering
def fmt(e, tasks, full=False):
    """Render one event as a list of lines."""
    t = e.get("ts", "")[5:16].replace("T", " ")
    typ = e.get("type")

    if typ == "start":
        lines = ["▶ %s %s [%s] %s" % (t, e["id"], who(e), e.get("title", ""))]
        if e.get("goal"):
            lines.append("    goal: " + (e["goal"] if full else one(e["goal"])))
        plan = e.get("plan") or []
        if plan:
            if full:
                lines.append("    plan:")
                lines.extend("      - " + p for p in plan)
            else:
                shown = "; ".join(one(p, 90) for p in plan[:3])
                extra = " …(+%d bước)" % (len(plan) - 3) if len(plan) > 3 else ""
                lines.append("    plan: " + shown + extra)
        sc, tg = e.get("scope") or [], e.get("tags") or []
        if sc or tg:
            bits = []
            if sc:
                bits.append("scope: " + ", ".join(sc[:6]) + (" …(+%d)" % (len(sc) - 6) if len(sc) > 6 else ""))
            if tg:
                bits.append("tags: " + ", ".join(tg[:6]))
            lines.append("    " + " | ".join(bits))
        acc = e.get("accept") or []
        if acc:
            lines.append("    accept: " + ("" if full else "; ".join(one(a, 90) for a in acc[:2]))
                         + ("" if full else " …(+%d)" % (len(acc) - 2) if len(acc) > 2 else ""))
        if e.get("refs"):
            lines.append("    refs: " + ", ".join(e["refs"][:8]))
        return lines

    if typ == "note":
        lines = ["  · %s %s [%s] %s" % (t, e.get("task", "?"), e.get("kind", "note"),
                                        e.get("text", "") if full else one(e.get("text", "")))]
        for d in (e.get("detail") or []):
            lines.append("      - " + d)
        return lines

    if typ == "end":
        st = tasks.get(e.get("task"))
        title = (" — «%s»" % st.get("title", "")) if st else ""
        lines = ["■ %s %s [%s] %s%s" % (t, e.get("task"), who(e), e.get("status"), title)]
        if e.get("summary"):
            lines.append("    summary: " + (e["summary"] if full else one(e["summary"])))
        counts = []
        for key, label in (("done", "done"), ("problems", "problems"), ("verify", "verify"),
                           ("metrics", "metrics"), ("next", "next")):
            items = e.get(key) or []
            if items:
                counts.append("%s:%d" % (label, len(items)))
        if counts:
            lines.append("    " + " · ".join(counts)
                         + (" · notes:%d" % e["notes"] if e.get("notes") else "")
                         + (" · %s" % fmt_duration(e.get("duration_s")) if e.get("duration_s") else ""))
        for key, label in (("problems", "problems"), ("next", "next")):
            items = e.get(key) or []
            if items and (full or len(items) <= 3):
                lines.append("    %s:" % label)
                lines.extend("      - " + i for i in items)
        if e.get("changes"):
            lines.append("    changes: " + ", ".join(e["changes"][:6])
                         + (" …(+%d)" % (len(e["changes"]) - 6) if len(e["changes"]) > 6 else ""))
        if e.get("commits"):
            lines.append("    commits: " + ", ".join(e["commits"][:5]))
        if e.get("lessons"):
            lines.append("    lessons: " + ", ".join(e["lessons"]))
        if e.get("impact"):
            lines.append("    impact: " + (e["impact"] if full else one(e["impact"])))
        if e.get("refs"):
            lines.append("    refs: " + ", ".join(e["refs"][:8]))
        return lines

    return []


def fmt_duration(seconds):
    try:
        seconds = int(seconds)
    except (TypeError, ValueError):
        return ""
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm%ds" % (seconds // 60, seconds % 60)
    return "%dh%dm" % (seconds // 3600, (seconds % 3600) // 60)


# --------------------------------------------------------------------------- sync
def load_cursor(sid):
    try:
        with open(cursor_path(sid), "r", encoding="utf-8") as f:
            cur = json.load(f)
        return cur if isinstance(cur, dict) else {}
    except (OSError, ValueError):
        return {}


def save_cursor(sid, cur):
    os.makedirs(CURSORS, exist_ok=True)
    path = cursor_path(sid)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cur, f)
    os.replace(tmp, path)


def sync(sid, all_=False, first=False, full=False, only=None):
    """Print unread events from other sessions and advance the cursor.

    The log is one file per day, shared by every session; each session keeps its
    own cursor (file name -> byte offset already read).
    """
    cur = load_cursor(sid)
    mine = session_events(sid)
    my_scope = [s for t in open_tasks(mine) for s in t.get("scope", [])]
    my_tags = set()
    for t in open_tasks(mine):
        my_tags.update(t.get("tags", []))
    allev, new = {}, []
    for fn in data_files():
        evs, off = read_file(fn)  # full read so task titles are available
        allev[fn] = evs
        if all_:
            new += evs
        elif first:
            cur[fn] = off
        else:
            nev, cur[fn] = read_file(fn, cur.get(fn, 0))
            new += nev
    tasks = {e["id"]: e for evs in allev.values() for e in evs if e.get("type") == "start"}
    if first and not all_:
        others = [e for evs in allev.values() for e in evs if e.get("session") != sid]
        open_ids = {t["id"] for t in open_tasks(others)}
        done_events = [e for e in others if e.get("type") == "end"][-RECENT_DONE:]
        done_ids = {e.get("task") for e in done_events}
        new = [e for e in others if e.get("type") == "start" and e["id"] in open_ids]
        new += [e for e in others if e.get("type") == "note" and e.get("task") in open_ids]
        # the plan/goal of a finished task is context worth showing too
        new += [e for e in others if e.get("type") == "start" and e["id"] in done_ids]
        new += [e for e in others if e.get("type") == "note" and e.get("task") in done_ids]
        new += done_events
    # a session never sees its own events as "somebody else's news"
    new = [e for e in new if e.get("type") in ("start", "note", "end") and e.get("session") != sid]
    if only:
        new = [e for e in new if e.get("task") == only or e.get("id") == only]
    new.sort(key=lambda e: e.get("ts", ""))
    if not all_:
        save_cursor(sid, cur)
    if not new:
        return
    hot = lambda e: (overlap(my_scope, e.get("scope", []) or e.get("changes", []))
                     or bool(my_tags & set(e.get("tags", []))))
    lines = []
    for e in sorted(new, key=lambda e: not hot(e)):  # stable sort: overlapping scope first
        block = fmt(e, tasks, full)
        if block:
            lines.append(("! " if hot(e) else "  ") + block[0])
            lines.extend(block[1:])
    stale = {e["id"] for evs in allev.values() for e in open_tasks(evs) if age_h(e["ts"]) > STALE_H}
    lines = [l + ("  (possibly abandoned)" if any(i in l for i in stale) and "▶" in l else "") for l in lines]
    print(NOTE)
    if not all_ and len(lines) > CAP:
        extra = len(lines) - CAP
        lines = lines[:CAP] + ["  … +%d more lines (relay sync --all)" % extra]
    print("\n".join(lines))


# --------------------------------------------------------------------------- show
def find_task(task_id):
    """Return (start_event, [notes], end_event) for a task id, searching every session."""
    start = notes = end = None
    for ev in all_events():
        if ev.get("type") == "start" and ev.get("id") == task_id:
            start = ev
        elif ev.get("type") == "note" and ev.get("task") == task_id:
            notes = (notes or []) + [ev]
        elif ev.get("type") == "end" and ev.get("task") == task_id:
            end = ev
    return start, notes or [], end


def render_task(start, notes, end, as_json=False):
    if as_json:
        for ev in ([start] if start else []) + notes + ([end] if end else []):
            print(json.dumps(ev, ensure_ascii=False, indent=2))
        return
    out = []
    title = (start or {}).get("title") or (end or {}).get("task") or "?"
    status = (end or {}).get("status") or "in progress"
    out.append("TASK %s  [%s]" % ((start or end or {}).get("id", "?"), status))
    out.append("  title:    %s" % title)
    out.append("  agent:    %s   session: %s" % ((start or end or {}).get("agent", "?"),
                                                (start or end or {}).get("session", "?")))
    out.append("  started:  %s" % ((start or {}).get("ts", "?")))
    if end:
        out.append("  ended:    %s   (%s)" % (end.get("ts", "?"), fmt_duration(end.get("duration_s"))))
    for key, label in (("goal", "goal"), ("summary", "summary"), ("impact", "impact")):
        src = start if key == "goal" else end
        val = (src or {}).get(key)
        if val:
            out.append("  %s: %s" % (label, val))
    for key, label in (("plan", "plan"), ("accept", "accept"), ("outs", "out of scope"),
                       ("done", "done"), ("problems", "problems"), ("verify", "verify"),
                       ("metrics", "metrics"), ("next", "next")):
        items = (start or {}).get(key) or (end or {}).get(key) or []
        if items:
            out.append("  %s:" % label)
            out.extend("    - %s" % i for i in items)
    for key, label in (("scope", "scope"), ("tags", "tags"), ("changes", "changes"),
                       ("commits", "commits"), ("lessons", "lessons"), ("refs", "refs")):
        items = (start or {}).get(key) or (end or {}).get(key) or []
        if items:
            out.append("  %s: %s" % (label, ", ".join(items)))
    if notes:
        out.append("  notes (%d):" % len(notes))
        for n in notes:
            out.append("    [%s] %s" % (n.get("kind", "note"), n.get("text", "")))
            for d in (n.get("detail") or []):
                out.append("      - %s" % d)
    print("\n".join(out))


# --------------------------------------------------------------------------- doctor
def doctor():
    """Print a quick health check. Never raises for missing data."""
    print("relay %s (schema %d)" % (VERSION, SCHEMA))
    print("root: %s" % ROOT)
    print("data: %s (%s)" % (DATA, "exists" if os.path.isdir(DATA) else "not created yet"))
    print("cursors: %s (%s)" % (CURSORS, "exists" if os.path.isdir(CURSORS) else "not created yet"))
    try:
        os.makedirs(DATA, exist_ok=True)
        probe = os.path.join(DATA, ".write-test")
        with open(probe, "w") as f:
            f.write("ok")
        os.remove(probe)
        print("data writable: yes")
    except OSError as ex:
        print("data writable: no (%s)" % ex)
    print("python: %s" % platform.python_version())
    print("git: %s" % (git("--version") or "not found (optional)"))
    for fn in data_files():
        evs, _ = read_file(fn)
        kinds = {}
        for e in evs:
            kinds[e.get("type", "?")] = kinds.get(e.get("type", "?"), 0) + 1
        sessions = {e.get("session") for e in evs if e.get("session")}
        print("  %s: %d events (%s), %d phiên, %d việc đang dở"
              % (fn, len(evs), ", ".join("%s:%d" % kv for kv in sorted(kinds.items())),
                 len(sessions), len(open_tasks(evs))))
    try:
        cursors = [f for f in os.listdir(CURSORS) if f.endswith(".json")]
    except OSError:
        cursors = []
    print("cursors: %d" % len(cursors))
    legacy = legacy_files()
    if legacy:
        print("legacy per-session files: %s (run 'relay migrate' to fold them into the day files)"
              % ", ".join(legacy))


# --------------------------------------------------------------------------- CLI
def add_list_arg(p, name, help_text):
    p.add_argument("--" + name, action="append", default=[], help=help_text)


def build_parser():
    p = argparse.ArgumentParser(prog="relay", description="Cross-agent work log.")
    p.add_argument("--version", action="version", version=VERSION)
    p.add_argument("--session", help="session id (else $RELAY_SESSION)")
    p.add_argument("--agent", help="agent name (else $RELAY_AGENT, else the session's own name)")
    p.add_argument("--model", default=os.environ.get("RELAY_MODEL", ""))

    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("start", help="open a task: what will be done and how")
    s.add_argument("title", help="one-line label (≤120 chars)")
    s.add_argument("--goal", default="", help="what and why (≤600 chars, multi-line ok)")
    add_list_arg(s, "plan", "one step of the plan (repeatable)")
    add_list_arg(s, "accept", "acceptance criteria / definition of done (repeatable)")
    add_list_arg(s, "out", "explicitly out of scope (repeatable)")
    add_list_arg(s, "scope", "paths expected to be touched (repeatable, comma ok)")
    add_list_arg(s, "tags", "keywords to make the work findable (repeatable, comma ok)")
    add_list_arg(s, "refs", "codes/URLs: T-65, L-42, #123 (repeatable, comma ok)")

    n = sub.add_parser("note", help="log progress, a problem, a decision, a result, a blocker")
    n.add_argument("task", nargs="?", help="task id (default: the open task of this session)")
    n.add_argument("--kind", default="progress", choices=list(KINDS))
    n.add_argument("--text", required=True, help="what happened (≤600 chars, multi-line ok)")
    add_list_arg(n, "detail", "extra lines: error output, measurements, context (repeatable)")
    add_list_arg(n, "refs", "codes/URLs (repeatable, comma ok)")

    e = sub.add_parser("end", help="close a task: what was done, problems, verification, next")
    e.add_argument("task", nargs="?", help="task id (default: the open task of this session)")
    e.add_argument("--status", default="done", choices=["done", "partial", "abandoned", "blocked"])
    e.add_argument("--summary", default="", help="dense summary of the outcome (≤1000 chars)")
    add_list_arg(e, "done", "a step that was actually completed (repeatable)")
    add_list_arg(e, "problem", "problem → resolution, or problem (UNRESOLVED) (repeatable)")
    add_list_arg(e, "verify", "how it was verified and the result (repeatable)")
    add_list_arg(e, "metric", "before → after (n=…, window=…) (repeatable)")
    add_list_arg(e, "changes", "files/dirs changed (repeatable, comma ok)")
    add_list_arg(e, "commit", "commit sha (repeatable, comma ok)")
    add_list_arg(e, "next", "open item / next step (repeatable)")
    add_list_arg(e, "lesson", "lesson code, e.g. L-42 (repeatable, comma ok)")
    add_list_arg(e, "refs", "codes/URLs (repeatable, comma ok)")
    e.add_argument("--impact", default="", help="what the next person must know (≤600 chars)")

    y = sub.add_parser("sync", help="print what other sessions did since your last sync")
    y.add_argument("--all", action="store_true", help="full history, do not advance the cursor")
    y.add_argument("--full", action="store_true", help="print fields in full, not compacted")
    y.add_argument("--task", help="only this task id")

    sh = sub.add_parser("show", help="print one task in full (all fields, all notes)")
    sh.add_argument("task", nargs="?", help="task id (default: the open task of this session)")
    sh.add_argument("--json", action="store_true", help="raw JSON events")

    mg = sub.add_parser("migrate", help="fold legacy per-session files into the day files")
    mg.add_argument("--dry-run", action="store_true", help="show what would move, write nothing")

    sub.add_parser("doctor", help="health check")
    sub.add_parser("version", help="print the version")
    return p


def pick_task(sid, args, allow_last=False, allow_session_last=False):
    """Find the task id to act on.

    Order: explicit id → open task of this session → single open task of this
    agent → the most recent task of this session (only for notes, so a
    correction can still be attached after the task was closed) → (only for
    read-only commands) the most recent task overall.
    """
    if getattr(args, "task", None):
        return args.task
    mine = session_events(sid)
    opn = open_tasks(mine)
    if opn:
        return opn[-1]["id"]
    agent = resolve_agent(sid, args)
    cands = []
    for fn in data_files():
        evs, _ = read_file(fn)
        for t in open_tasks(evs):
            join = next((e for e in evs if e.get("type") == "join"
                         and e.get("session") == t.get("session")), {})
            if join.get("agent") == agent:
                cands.append(t)
    if len(cands) == 1:
        return cands[0]["id"]
    if len(cands) > 1:
        print("[relay] nhiều việc đang dở của agent '%s', chọn rõ task id: %s"
              % (agent, ", ".join(t["id"] for t in cands)), file=sys.stderr)
        return None
    if allow_session_last:
        started = [e for e in mine if e.get("type") == "start"]
        if started:
            return started[-1]["id"]
    if allow_last:
        ids = [e.get("id") for e in all_events() if e.get("type") == "start"]
        if ids:
            return ids[-1]
    return None


def main():
    args = build_parser().parse_args()

    if args.cmd == "version":
        print(VERSION)
        return
    if args.cmd == "doctor":
        doctor()
        return
    if args.cmd == "migrate":
        report = migrate(args.dry_run)
        for line in report:
            print(line)
        print("dry run: nothing written" if args.dry_run else "migrated %d file(s)" % len(report))
        return

    # fold v1/v2 per-session files into the day files (kept in data/legacy/)
    if legacy_files():
        report = migrate()
        for line in report:
            print("[relay] migrated %s" % line, file=sys.stderr)

    sid, gen = session_id(args)
    read_only = args.cmd == "show"
    if read_only:
        # read-only commands must not create a stray session
        first = False
    else:
        first = ensure_join(sid, args)
    if gen:
        print("session=%s  (reuse: --session %s or RELAY_SESSION)" % (sid, sid))

    if args.cmd == "sync":
        sync(sid, args.all, first, args.full, args.task)
    elif args.cmd == "show":
        task = pick_task(sid, args, allow_last=True)
        if not task:
            print("[relay] không tìm thấy task; truyền rõ task id", file=sys.stderr)
            return
        start, notes, end = find_task(task)
        render_task(start, notes, end, args.json)
    elif args.cmd == "start":
        sync(sid, first=first)
        scope = flat(args.scope)
        ev = base(sid, args, "start")
        ev.update({
            "title": clip_text(args.title, TEXT_LIMITS["title"]) or "untitled",
            "goal": clip_text(args.goal, TEXT_LIMITS["goal"]),
            "plan": clip_list(args.plan, *LIST_LIMITS["plan"]),
            "accept": clip_list(args.accept, *LIST_LIMITS["accept"]),
            "outs": clip_list(args.out, *LIST_LIMITS["outs"]),
            "scope": clip_list(scope, *LIST_LIMITS["scope"]),
            "tags": clip_list(flat(args.tags), *LIST_LIMITS["tags"]),
            "refs": clip_list(flat(args.refs), *LIST_LIMITS["refs"]),
            "status": "planned",
        })
        clash = [t for t in open_tasks([e for e in all_events() if e.get("session") != sid])
                 if overlap(scope, t.get("scope", []))]
        append(sid, ev)
        print("task=%s" % ev["id"])
        for t in clash:
            print("! scope overlaps open work [%s] %s: %s" % (who(t), t["id"], t.get("title", "")))
    elif args.cmd == "note":
        task = pick_task(sid, args, allow_session_last=True)
        if not task:
            print("[relay] không có task để ghi note; truyền rõ task id", file=sys.stderr)
            return
        ev = base(sid, args, "note")
        ev.update({
            "task": task,
            "kind": args.kind,
            "text": clip_text(args.text, TEXT_LIMITS["text"]),
            "detail": clip_list(args.detail, *LIST_LIMITS["detail"]),
            "refs": clip_list(flat(args.refs), *LIST_LIMITS["refs"]),
        })
        append(sid, ev)
        print("note=%s task=%s" % (ev["id"], task))
    elif args.cmd == "end":
        task = pick_task(sid, args)
        if not task:
            print("[relay] không có việc đang dở để kết thúc", file=sys.stderr)
            return
        start, notes, _end = find_task(task)
        duration = 0
        if start:
            try:
                t0 = datetime.strptime(start["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
                duration = int((datetime.now(timezone.utc) - t0).total_seconds())
            except (KeyError, ValueError):
                duration = 0
        ev = base(sid, args, "end")
        ev.update({
            "task": task,
            "status": args.status,
            "summary": clip_text(args.summary, TEXT_LIMITS["summary"]),
            "done": clip_list(args.done, *LIST_LIMITS["done"]),
            "problems": clip_list(args.problem, *LIST_LIMITS["problems"]),
            "verify": clip_list(args.verify, *LIST_LIMITS["verify"]),
            "metrics": clip_list(args.metric, *LIST_LIMITS["metrics"]),
            "changes": clip_list(flat(args.changes), *LIST_LIMITS["changes"]),
            "commits": clip_list(flat(args.commit), *LIST_LIMITS["commits"]),
            "impact": clip_text(args.impact, TEXT_LIMITS["impact"]),
            "next": clip_list(args.next, *LIST_LIMITS["next"]),
            "lessons": clip_list(flat(args.lesson), *LIST_LIMITS["lessons"]),
            "refs": clip_list(flat(args.refs), *LIST_LIMITS["refs"]),
            "duration_s": duration,
            "notes": len(notes),
        })
        append(sid, ev)
        print("ended=%s status=%s duration=%s notes=%d"
              % (task, ev["status"], fmt_duration(duration), len(notes)))
        sync(sid)


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception as ex:  # logging must never block the main work
        print("[relay] error: %s" % ex, file=sys.stderr)
