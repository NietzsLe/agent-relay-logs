#!/usr/bin/env python3
"""relay — per-session work log for multiple agents (schema v4).

Layout (v3+):
  data/YYYY-MM-DD.jsonl   every event of that UTC day, all sessions, one file
  cursors/<session>.json  per-session read cursor: {data file -> byte offset}
  keys/<key>.json         harness session -> relay session mapping (for hooks)
  data/legacy/            per-session files from v1/v2, kept after migration

One JSON object per line. Event types:

  join  — session profile (agent, model, host, cwd, branch, head…)
  start — a task opens: what will be done, how, and how "done" is judged
  note  — while working: progress / problem / decision / result / blocker
  scope — the working scope changed: files added + why (no exemption is ever
          written in the docs; the tool detects drift instead)
  wait  — a long command started: what runs + estimated time (eta)
  run   — that command finished: actual time, exit code, late/over vs eta
  end   — a task closes: what was done, problems, verification, next steps

Rhythm enforcement (mechanical, not advisory):
  GAP_MAX (default 600s): a task must log at least every 10 minutes of active
  work (time inside wait/run windows does not count). `tick` reports the
  silence; hooks surface it; `end` records it in the score.

Every event type carries detail, because a log that only says "task X started"
tells the next session nothing useful. See README.md next to this file.
Python standard library only.
"""
import argparse
import json
import os
import platform
import random
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone

VERSION = "4.0.0"
SCHEMA = 4
ROOT = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(ROOT, "data")
CURSORS = os.path.join(ROOT, "cursors")
KEYS = os.path.join(ROOT, "keys")
LEGACY = os.path.join(DATA, "legacy")
DAY_RE = re.compile(r"^\d{4}-\d{2}-\d{2}\.jsonl$")
STALE_H = float(os.environ.get("RELAY_STALE_HOURS", "12"))
GAP_MAX = float(os.environ.get("RELAY_GAP_MAX", "600"))        # hard rhythm limit (s)
NUDGE_AFTER = float(os.environ.get("RELAY_NUDGE", "480"))      # soft reminder (s)
MIN_DECLARE = float(os.environ.get("RELAY_MIN_DECLARE", "120"))  # declare above this (s)
CAP = 25          # maximum lines printed by one sync
RECENT_DONE = 10  # first sync in a session: number of recently finished items
MAX_LINE = 8000   # hard cap for one event line (JSON must stay valid)
NOTE = "[relay] log is only relatively complete — verify git/real state before relying on it"

KINDS = ("progress", "problem", "decision", "result", "blocker", "question")

# field -> (max items, max chars per item) for list fields
LIST_LIMITS = {
    "plan": (12, 300), "accept": (8, 300), "outs": (8, 300), "scope": (30, 200),
    "tags": (12, 60), "refs": (20, 200), "detail": (20, 300), "done": (20, 300),
    "problems": (20, 400), "verify": (12, 300), "metrics": (12, 200),
    "changes": (40, 200), "commits": (10, 60), "next": (12, 300), "lessons": (8, 40),
    "where": (12, 120), "add": (30, 200),
}
TEXT_LIMITS = {
    "title": 120, "goal": 600, "text": 600, "summary": 1000, "impact": 600,
}


# --------------------------------------------------------------------------- utils
def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def age_h(ts):
    t = datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    return (datetime.now(timezone.utc) - t).total_seconds() / 3600


def rid():
    return time.strftime("%y%m%d-%H%M%S", time.gmtime()) + "-" + "%03x" % random.randrange(4096)


def git(*a):
    try:
        return subprocess.run(["git", *a], capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""


def clip_text(v, n):
    """Truncate but keep the marker explicit, and keep newlines (detail matters)."""
    v = (v or "").rstrip()
    if len(v) <= n:
        return v
    return v[: max(0, n - 20)].rstrip() + " …(+%d ký tự)" % (len(v) - n)


def clip_list(items, count, width):
    out = []
    for item in items:
        item = clip_text(item, width)
        if item:
            out.append(item)
    if len(out) > count:
        out = out[:count] + ["…(+%d mục)" % (len(out) - count)]
    return out


def smart_split(s):
    """Split on commas that are not inside brackets or quotes.

    Plain `s.split(",")` destroys paths and prose like
    "repo (new, commit c4675a6)" — that bug is why this exists.
    """
    out, buf, depth, quote = [], [], 0, ""
    for ch in s or "":
        if quote:
            buf.append(ch)
            if ch == quote:
                quote = ""
            continue
        if ch in "\"'":
            quote = ch
            buf.append(ch)
            continue
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            depth = max(0, depth - 1)
        if ch == "," and depth == 0:
            out.append("".join(buf).strip())
            buf = []
            continue
        buf.append(ch)
    if buf:
        out.append("".join(buf).strip())
    return [x for x in out if x]


def flat(values, split=True):
    """Flatten repeatable CLI options into one list."""
    out = []
    for v in values or []:
        out.extend(smart_split(v) if split else [v])
    return [x for x in out if x]


def one(text, limit=160):
    """Render multi-line text on a single line for compact output."""
    text = " ".join((text or "").split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


# --------------------------------------------------------------------------- storage
def day_stamp(ts=None):
    """UTC day of an event timestamp (or today)."""
    if ts:
        return ts[:10]
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


def day_path(day=None):
    return os.path.join(DATA, "%s.jsonl" % (day or day_stamp()))


def is_day_file(name):
    return bool(DAY_RE.match(name))


def cursor_path(sid):
    return os.path.join(CURSORS, sid + ".json")


def data_files():
    """Day files first, then legacy per-session files that still need migrating."""
    try:
        names = sorted(os.listdir(DATA))
    except OSError:
        return []
    days = [n for n in names if is_day_file(n)]
    legacy = [n for n in names if n.endswith(".jsonl") and not is_day_file(n)]
    return days + legacy


def legacy_files():
    try:
        return sorted(n for n in os.listdir(DATA) if n.endswith(".jsonl") and not is_day_file(n))
    except OSError:
        return []


def write_event(ev, day=None):
    """Append one event to a day file. The line is always valid JSON."""
    os.makedirs(DATA, exist_ok=True)
    line = json.dumps(ev, ensure_ascii=False)
    if len(line) + 1 > MAX_LINE:
        ev = shrink(ev)
        line = json.dumps(ev, ensure_ascii=False)
        if len(line) + 1 > MAX_LINE:
            keep = {k: ev[k] for k in ("id", "ts", "type", "v", "session", "agent", "task")
                    if k in ev}
            keep["trimmed"] = True
            keep["title"] = clip_text(ev.get("title", ""), 120)
            keep["summary"] = clip_text(ev.get("summary", ""), 200)
            keep["text"] = clip_text(ev.get("text", ""), 200)
            line = json.dumps(keep, ensure_ascii=False)
    # one write() call with O_APPEND: concurrent sessions never interleave a line
    fd = os.open(day_path(day), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, (line + "\n").encode())
    finally:
        os.close(fd)


def append(sid, ev):
    """Append one event to today's file."""
    write_event(ev)


def shrink(ev):
    """Reduce an oversized event while keeping it informative and valid."""
    ev = dict(ev)
    for key in LIST_LIMITS:
        if isinstance(ev.get(key), list) and len(ev[key]) > 1:
            ev[key] = ev[key][:1]
    for key in TEXT_LIMITS:
        if key in ev:
            ev[key] = clip_text(ev[key], 200)
    ev["trimmed"] = True
    return ev


def read_file(fn, offset=0):
    """Return (events, new_offset); only complete newline-terminated lines are read."""
    evs = []
    try:
        with open(os.path.join(DATA, fn), "rb") as f:
            f.seek(offset)
            raw = f.read()
    except OSError:
        return evs, offset
    end = raw.rfind(b"\n") + 1
    for ln in raw[:end].splitlines():
        try:
            evs.append(json.loads(ln))
        except ValueError:
            pass
    return evs, offset + end


def all_events():
    out = []
    for fn in data_files():
        evs, _ = read_file(fn)
        out.extend(evs)
    return out


def session_events(sid):
    """Every event written by this session, across all day files."""
    return [e for e in all_events() if e.get("session") == sid]


def migrate(dry_run=False):
    """Move v1/v2 per-session files into the day files.

    The original files are kept in data/legacy/ — nothing is deleted.
    """
    report = []
    for name in legacy_files():
        events, _ = read_file(name)
        by_day = {}
        for e in events:
            by_day.setdefault(day_stamp(e.get("ts")), []).append(e)
        for day, evs in by_day.items():
            existing, _ = read_file("%s.jsonl" % day)
            known = {e.get("id") for e in existing}
            fresh = [e for e in evs if e.get("id") not in known]
            for e in fresh:
                if not dry_run:
                    write_event(e, day)
            report.append("%s -> %s.jsonl: %d sự kiện (%d mới)"
                          % (name, day, len(evs), len(fresh)))
        if not dry_run:
            os.makedirs(LEGACY, exist_ok=True)
            dest = os.path.join(LEGACY, name)
            if not os.path.exists(dest):
                shutil.move(os.path.join(DATA, name), dest)
    return report


def open_tasks(evs):
    starts = {e["id"]: e for e in evs if e.get("type") == "start"}
    for e in evs:
        if e.get("type") == "end":
            starts.pop(e.get("task"), None)
    return list(starts.values())


def overlap(a, b):
    return any(x == y or x.startswith(y.rstrip("/") + "/") or y.startswith(x.rstrip("/") + "/")
               for x in a for y in b)


def who(e):
    return "%s:%s" % (e.get("agent", "?"), e.get("session", "?")[:8])


# --------------------------------------------------------------------------- rhythm & score
def parse_ts(ts):
    try:
        return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None


def task_related(task_id):
    """All events of one task, oldest first."""
    out = [e for e in all_events()
           if e.get("id") == task_id or e.get("task") == task_id]
    out.sort(key=lambda e: e.get("ts", ""))
    return out


def effective_scope(start_ev, scope_evs):
    scope = list((start_ev or {}).get("scope") or [])
    for e in scope_evs or []:
        scope += e.get("add") or []
    return scope


def git_modified():
    """Files with uncommitted changes."""
    out = []
    for ln in git("status", "--porcelain").splitlines():
        ln = ln.rstrip()
        if not ln:
            continue
        path = ln[3:] if len(ln) > 3 else ln[2:].strip()
        if " -> " in path:  # renames: take the new name
            path = path.split(" -> ")[-1].strip().strip('"')
        path = path.strip().strip('"')
        if path:
            out.append(path)
    return out


def outside_scope(files, scope):
    if not scope:
        return []
    return [f for f in files if not any(overlap([f], [s]) for s in scope)]


def run_late_over(eta_s, actual_s):
    """(late_s, over_s): tolerance both ways so eta cannot be gamed."""
    eta_s, actual_s = int(eta_s or 0), int(actual_s or 0)
    if eta_s <= 0:
        if actual_s > MIN_DECLARE:
            return int(actual_s - MIN_DECLARE), 0
        return 0, 0
    tol = max(60, 0.25 * eta_s)
    late = max(0, actual_s - eta_s - tol)
    over = 0
    if actual_s < eta_s:
        over = max(0, eta_s - actual_s - max(60, 0.75 * eta_s))
    return int(late), int(over)


def task_timing(task_id, start_ev=None, end_ev=None, now_dt=None):
    """Rhythm numbers for one task. Wait windows never count as silence."""
    now_dt = now_dt or datetime.now(timezone.utc)
    evs = task_related(task_id)
    if start_ev is None:
        start_ev = next((e for e in evs if e.get("type") == "start"), None)
    if end_ev is None:
        end_ev = next((e for e in evs if e.get("type") == "end"), None)
    t0 = parse_ts((start_ev or {}).get("ts")) if start_ev else None
    t1 = (parse_ts(end_ev.get("ts")) or now_dt) if end_ev else now_dt
    duration = max(0, int((t1 - t0).total_seconds())) if t0 else 0
    notes = [e for e in evs if e.get("type") == "note"]
    scopes = [e for e in evs if e.get("type") == "scope"]
    runs = [e for e in evs if e.get("type") == "run"]
    waits = [e for e in evs if e.get("type") == "wait"]
    scope = effective_scope(start_ev, scopes)
    late_total = sum(int(r.get("late_s") or 0) for r in runs)
    over_total = sum(int(r.get("over_s") or 0) for r in runs)
    wait_s = sum(int(r.get("actual_s") or 0) for r in runs)
    points = []
    for e in evs:
        if e.get("type") in ("start", "note", "scope"):
            t = parse_ts(e.get("ts"))
            if t:
                points.append((t, e))
    for r in runs:
        t = parse_ts(r.get("ts"))
        if t:
            points.append((t, r))
    if end_ev:
        t = parse_ts(end_ev.get("ts"))
        if t:
            points.append((t, end_ev))
    points.sort(key=lambda p: p[0])
    gaps, silence_max = [], 0
    for (a, _ea), (b, eb) in zip(points, points[1:]):
        gap = (b - a).total_seconds()
        if eb.get("type") == "run":
            gap = max(0, gap - int(eb.get("actual_s") or 0))
        gaps.append(gap)
        silence_max = max(silence_max, gap)
    open_wait = None
    if not end_ev and waits:
        last_wait = max(waits, key=lambda e: e.get("ts", ""))
        runs_after = [r for r in runs if r.get("ts", "") >= last_wait.get("ts", "")]
        if not runs_after:
            open_wait = last_wait
    if open_wait:
        wt = parse_ts(open_wait.get("ts"))
        eta = int(open_wait.get("eta_s") or 0)
        if wt:
            elapsed = (now_dt - wt).total_seconds()
            window = max(2 * eta, MIN_DECLARE) if eta > 0 else MIN_DECLARE
            wait_s += int(min(max(0, elapsed), window))
            if elapsed > window:
                gaps.append(elapsed - window)
                silence_max = max(silence_max, elapsed - window)
    elif not end_ev and points:
        # open task, not waiting: the silence since the last log line counts
        current = (now_dt - points[-1][0]).total_seconds()
        gaps.append(max(0, current))
        silence_max = max(silence_max, current)
    overdue = sum(max(0, g - GAP_MAX) for g in gaps) + late_total + 0.5 * over_total
    active = max(0, duration - int(wait_s))
    return {"duration_s": duration, "wait_s": int(wait_s), "active_s": active,
            "silence_max_s": int(silence_max), "overdue_s": overdue,
            "late_s": int(late_total), "over_s": int(over_total),
            "notes": len(notes), "scopes": len(scopes), "runs": len(runs),
            "scope": scope, "open_wait": open_wait}


def task_score(task_id, start_ev=None, end_ev=None, changes=None, forced=False):
    """Score 0-100: rhythm 50, scope 20, close 20, open 10, forced -10."""
    tm = task_timing(task_id, start_ev, end_ev)
    active = max(tm["active_s"], 60)
    cadence = max(0.0, 50 * (1 - tm["overdue_s"] / active))
    if changes is None and end_ev:
        changes = end_ev.get("changes") or []
    drift = outside_scope(changes or [], tm["scope"]) if tm["scope"] else []
    scope_pts = max(0, 20 - 10 * len(drift))
    close = 0
    if end_ev:
        if end_ev.get("summary"):
            close += 6
        if end_ev.get("done"):
            close += 4
        if end_ev.get("verify"):
            close += 6
        if end_ev.get("next"):
            close += 4
    open_pts = 0
    if start_ev:
        if start_ev.get("goal"):
            open_pts += 4
        if start_ev.get("plan"):
            open_pts += 3
        if start_ev.get("scope"):
            open_pts += 3
    total = cadence + scope_pts + close + open_pts - (10 if forced else 0)
    return {"score": max(0, int(round(total))), "cadence": round(cadence, 1),
            "scope": scope_pts, "close": close, "open": open_pts,
            "silence_max_s": tm["silence_max_s"], "overdue_s": round(tm["overdue_s"], 1),
            "wait_s": tm["wait_s"], "late_s": tm["late_s"], "over_s": tm["over_s"],
            "scope_drift": drift, "forced": forced, "notes": tm["notes"]}


def end_gate(task_id, start_ev, changes, status):
    """Hard, checkable gate at close time. Returns (gate list, timing)."""
    tm = task_timing(task_id, start_ev, None)
    gate = []
    if tm["silence_max_s"] > GAP_MAX:
        gate.append("im lặng %ds quá hạn %ds (wait đã trừ)"
                    % (tm["silence_max_s"], int(GAP_MAX)))
    if tm["late_s"] > 0:
        gate.append("ước tính lệnh sai: trễ %ds quá tolerance" % tm["late_s"])
    drift = outside_scope(changes or [], tm["scope"]) if tm["scope"] else []
    if drift:
        gate.append("ngoài scope chưa log: %s" % ", ".join(drift[:5]))
    return gate, tm, drift


# --------------------------------------------------------------------------- session
def explicit_agent(args):
    if getattr(args, "agent", None):
        return args.agent
    return os.environ.get("RELAY_AGENT") or None


def key_name(args):
    return getattr(args, "key", None) or os.environ.get("RELAY_KEY") or None


def key_file(key):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", key or "")[:64] or "default"
    return os.path.join(KEYS, safe + ".json")


def load_key(key):
    try:
        with open(key_file(key), "r", encoding="utf-8") as f:
            data = json.load(f)
        sid = data.get("session") if isinstance(data, dict) else None
        return sid or None
    except (OSError, ValueError):
        return None


def save_key(key, sid):
    try:
        os.makedirs(KEYS, exist_ok=True)
        tmp = key_file(key) + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"session": sid, "updated": now()}, f)
        os.replace(tmp, key_file(key))
    except OSError:
        pass


def session_agent(sid):
    """Agent name recorded when this session joined — so later commands need not repeat it."""
    for e in session_events(sid):
        if e.get("type") == "join":
            return e.get("agent") or None
    return None


def resolve_agent(sid, args):
    return explicit_agent(args) or session_agent(sid) or "agent"


def session_id(args):
    sid = args.session or os.environ.get("RELAY_SESSION")
    new = False
    key = key_name(args)
    if not sid and key:
        sid = load_key(key)
    if key and sid:
        save_key(key, sid)
    if not sid:
        sid = "%s-%s" % (explicit_agent(args) or "agent", rid())
        new = True
        if key:
            save_key(key, sid)
    return sid, new


def existing_sid(args):
    """Resolve a session id without creating anything (for tick/guard)."""
    sid = args.session or os.environ.get("RELAY_SESSION")
    if sid:
        return sid
    key = key_name(args)
    if key:
        return load_key(key)
    return None


def parse_dur(text):
    """Parse '8m', '90s', '1h30m', '500' into seconds. None when unparsable."""
    if text is None:
        return None
    if isinstance(text, (int, float)):
        return int(text)
    s = str(text).strip().lower().replace(" ", "")
    if not s:
        return None
    if re.fullmatch(r"\d+(\.\d+)?", s):
        return int(float(s))
    total, num = 0, ""
    units = {"h": 3600, "m": 60, "s": 1}
    for ch in s:
        if ch.isdigit() or ch == ".":
            num += ch
        elif ch in units and num:
            total += float(num) * units[ch]
            num = ""
        else:
            return None
    if num:
        return None
    return int(total)


def ensure_join(sid, args):
    """Write the session profile line for a new session. Return True if new."""
    if any(e.get("type") == "join" for e in session_events(sid)):
        return False
    dirty = len(git("status", "--porcelain").splitlines())
    gd, gc = git("rev-parse", "--git-dir"), git("rev-parse", "--git-common-dir")
    cwd = os.getcwd()
    append(sid, {
        "id": rid(), "ts": now(), "type": "join", "v": SCHEMA, "session": sid,
        "agent": explicit_agent(args) or "agent", "model": args.model or "",
        "user": os.environ.get("USER", ""), "host": platform.node(), "pid": os.getppid(),
        "cwd": cwd, "project": os.path.basename(cwd), "branch": git("rev-parse", "--abbrev-ref", "HEAD"),
        "head": git("rev-parse", "--short", "HEAD"), "worktree": bool(gd and gd != gc), "dirty": dirty,
    })
    return True


def base(sid, args, typ):
    return {"id": rid(), "ts": now(), "type": typ, "v": SCHEMA, "session": sid,
            "agent": resolve_agent(sid, args), "cwd": os.getcwd(),
            "branch": git("rev-parse", "--abbrev-ref", "HEAD"),
            "head": git("rev-parse", "--short", "HEAD")}


# --------------------------------------------------------------------------- rendering
def fmt(e, tasks, full=False):
    """Render one event as a list of lines."""
    t = e.get("ts", "")[5:16].replace("T", " ")
    typ = e.get("type")

    if typ == "start":
        lines = ["▶ %s %s [%s] %s" % (t, e["id"], who(e), e.get("title", ""))]
        if e.get("goal"):
            lines.append("    goal: " + (e["goal"] if full else one(e["goal"])))
        plan = e.get("plan") or []
        if plan:
            if full:
                lines.append("    plan:")
                lines.extend("      - " + p for p in plan)
            else:
                shown = "; ".join(one(p, 90) for p in plan[:3])
                extra = " …(+%d bước)" % (len(plan) - 3) if len(plan) > 3 else ""
                lines.append("    plan: " + shown + extra)
        sc, tg = e.get("scope") or [], e.get("tags") or []
        if sc or tg:
            bits = []
            if sc:
                bits.append("scope: " + ", ".join(sc[:6]) + (" …(+%d)" % (len(sc) - 6) if len(sc) > 6 else ""))
            if tg:
                bits.append("tags: " + ", ".join(tg[:6]))
            lines.append("    " + " | ".join(bits))
        acc = e.get("accept") or []
        if acc:
            lines.append("    accept: " + ("" if full else "; ".join(one(a, 90) for a in acc[:2]))
                         + ("" if full else " …(+%d)" % (len(acc) - 2) if len(acc) > 2 else ""))
        if e.get("refs"):
            lines.append("    refs: " + ", ".join(e["refs"][:8]))
        return lines

    if typ == "note":
        lines = ["  · %s %s [%s] %s" % (t, e.get("task", "?"), e.get("kind", "note"),
                                        e.get("text", "") if full else one(e.get("text", "")))]
        if e.get("next"):
            lines.append("    next: " + (e["next"] if full else one(e["next"])))
        for d in (e.get("detail") or []):
            lines.append("      - " + d)
        if e.get("where"):
            lines.append("    where: " + ", ".join(e["where"][:6]))
        if e.get("refs"):
            lines.append("    refs: " + ", ".join(e["refs"][:8]))
        return lines

    if typ == "scope":
        lines = ["  + %s %s scope +%s" % (t, e.get("task", "?"),
                                          ", ".join((e.get("add") or [])[:6]))]
        if e.get("why"):
            lines.append("    why: " + (e["why"] if full else one(e["why"])))
        return lines

    if typ == "run":
        flag = ""
        if e.get("late_s"):
            flag = "  LATE +%ds" % e["late_s"]
        elif e.get("over_s"):
            flag = "  (over +%ds)" % e["over_s"]
        return ["  = %s %s run %s %s (eta %s) exit %s%s"
                % (t, e.get("task", "?"), one(e.get("cmd", ""), 80),
                   fmt_duration(e.get("actual_s")), fmt_duration(e.get("eta_s")),
                   e.get("exit", "?"), flag)]

    if typ == "end":
        st = tasks.get(e.get("task"))
        title = (" — «%s»" % st.get("title", "")) if st else ""
        lines = ["■ %s %s [%s] %s%s" % (t, e.get("task"), who(e), e.get("status"), title)]
        if e.get("summary"):
            lines.append("    summary: " + (e["summary"] if full else one(e["summary"])))
        counts = []
        for key, label in (("done", "done"), ("problems", "problems"), ("verify", "verify"),
                           ("metrics", "metrics"), ("next", "next")):
            items = e.get(key) or []
            if items:
                counts.append("%s:%d" % (label, len(items)))
        if counts:
            lines.append("    " + " · ".join(counts)
                         + (" · notes:%d" % e["notes"] if e.get("notes") else "")
                         + (" · %s" % fmt_duration(e.get("duration_s")) if e.get("duration_s") else ""))
        for key, label in (("problems", "problems"), ("next", "next")):
            items = e.get(key) or []
            if items and (full or len(items) <= 3):
                lines.append("    %s:" % label)
                lines.extend("      - " + i for i in items)
        if e.get("changes"):
            lines.append("    changes: " + ", ".join(e["changes"][:6])
                         + (" …(+%d)" % (len(e["changes"]) - 6) if len(e["changes"]) > 6 else ""))
        if e.get("commits"):
            lines.append("    commits: " + ", ".join(e["commits"][:5]))
        if e.get("lessons"):
            lines.append("    lessons: " + ", ".join(e["lessons"]))
        if e.get("impact"):
            lines.append("    impact: " + (e["impact"] if full else one(e["impact"])))
        if e.get("refs"):
            lines.append("    refs: " + ", ".join(e["refs"][:8]))
        return lines

    return []


def fmt_duration(seconds):
    try:
        seconds = int(seconds)
    except (TypeError, ValueError):
        return ""
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm%ds" % (seconds // 60, seconds % 60)
    return "%dh%dm" % (seconds // 3600, (seconds % 3600) // 60)


# --------------------------------------------------------------------------- sync
def load_cursor(sid):
    try:
        with open(cursor_path(sid), "r", encoding="utf-8") as f:
            cur = json.load(f)
        return cur if isinstance(cur, dict) else {}
    except (OSError, ValueError):
        return {}


def save_cursor(sid, cur):
    os.makedirs(CURSORS, exist_ok=True)
    path = cursor_path(sid)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cur, f)
    os.replace(tmp, path)


def sync(sid, all_=False, first=False, full=False, only=None):
    """Print unread events from other sessions and advance the cursor.

    The log is one file per day, shared by every session; each session keeps its
    own cursor (file name -> byte offset already read).
    """
    cur = load_cursor(sid)
    mine = session_events(sid)
    my_scope = [s for t in open_tasks(mine) for s in t.get("scope", [])]
    my_tags = set()
    for t in open_tasks(mine):
        my_tags.update(t.get("tags", []))
    allev, new = {}, []
    for fn in data_files():
        evs, off = read_file(fn)  # full read so task titles are available
        allev[fn] = evs
        if all_:
            new += evs
        elif first:
            cur[fn] = off
        else:
            nev, cur[fn] = read_file(fn, cur.get(fn, 0))
            new += nev
    tasks = {e["id"]: e for evs in allev.values() for e in evs if e.get("type") == "start"}
    if first and not all_:
        others = [e for evs in allev.values() for e in evs if e.get("session") != sid]
        open_ids = {t["id"] for t in open_tasks(others)}
        done_events = [e for e in others if e.get("type") == "end"][-RECENT_DONE:]
        done_ids = {e.get("task") for e in done_events}
        new = [e for e in others if e.get("type") == "start" and e["id"] in open_ids]
        new += [e for e in others if e.get("type") in ("note", "scope", "run")
                and e.get("task") in open_ids]
        # the plan/goal of a finished task is context worth showing too
        new += [e for e in others if e.get("type") == "start" and e["id"] in done_ids]
        new += [e for e in others if e.get("type") in ("note", "scope", "run")
                and e.get("task") in done_ids]
        new += done_events
    # a session never sees its own events as "somebody else's news"
    new = [e for e in new if e.get("type") in ("start", "note", "end", "scope", "run")
           and e.get("session") != sid]
    if only:
        new = [e for e in new if e.get("task") == only or e.get("id") == only]
    new.sort(key=lambda e: e.get("ts", ""))
    if not all_:
        save_cursor(sid, cur)
    if not new:
        return
    parallel = board_lines(sid, limit=5, only_others=True)
    hot = lambda e: (overlap(my_scope, e.get("scope", []) or e.get("changes", []))
                     or bool(my_tags & set(e.get("tags", []))))
    lines = []
    for e in sorted(new, key=lambda e: not hot(e)):  # stable sort: overlapping scope first
        block = fmt(e, tasks, full)
        if block:
            lines.append(("! " if hot(e) else "  ") + block[0])
            lines.extend(block[1:])
    stale = {e["id"] for evs in allev.values() for e in open_tasks(evs) if age_h(e["ts"]) > STALE_H}
    lines = [l + ("  (possibly abandoned)" if any(i in l for i in stale) and "▶" in l else "") for l in lines]
    print(NOTE)
    if parallel:
        print("◆ đang chạy song song (%d):" % len(parallel))
        for pl in parallel:
            print("  " + pl)
    if not all_ and len(lines) > CAP:
        extra = len(lines) - CAP
        lines = lines[:CAP] + ["  … +%d more lines (relay sync --all)" % extra]
    if lines:
        print("\n".join(lines))


def warn_quality(typ, fields):
    """Non-blocking nudges on stderr: a thin log is the main way relay loses value."""
    wanted = {
        "start": (("plan", "--plan"), ("accept", "--accept"), ("scope", "--scope")),
        "end": (("summary", "--summary"), ("verify", "--verify")),
    }.get(typ, ())
    missing = [flag for key, flag in wanted if not fields.get(key)]
    if missing:
        print("[relay] thin %s event, add: %s (next session reads this)" % (typ, " ".join(missing)),
              file=sys.stderr)


