    print("root: %s" % ROOT)
    print("data: %s (%s)" % (DATA, "exists" if os.path.isdir(DATA) else "not created yet"))
    print("cursors: %s (%s)" % (CURSORS, "exists" if os.path.isdir(CURSORS) else "not created yet"))
    try:
        os.makedirs(DATA, exist_ok=True)
        probe = os.path.join(DATA, ".write-test")
        with open(probe, "w") as f:
            f.write("ok")
        os.remove(probe)
        print("data writable: yes")
    except OSError as ex:
        print("data writable: no (%s)" % ex)
    print("python: %s" % platform.python_version())
    print("git: %s" % (git("--version") or "not found (optional)"))
    for fn in data_files():
        evs, _ = read_file(fn)
        kinds = {}
        for e in evs:
            kinds[e.get("type", "?")] = kinds.get(e.get("type", "?"), 0) + 1
        sessions = {e.get("session") for e in evs if e.get("session")}
        print("  %s: %d events (%s), %d phiên, %d việc đang dở"
              % (fn, len(evs), ", ".join("%s:%d" % kv for kv in sorted(kinds.items())),
                 len(sessions), len(open_tasks(evs))))
    try:
        cursors = [f for f in os.listdir(CURSORS) if f.endswith(".json")]
    except OSError:
        cursors = []
    print("cursors: %d" % len(cursors))
    closed = {e.get("task") for e in all_events() if e.get("type") == "end"}
    stale = [t for fn in data_files() for t in open_tasks(read_file(fn)[0])
             if t["id"] not in closed and age_h(t["ts"]) > STALE_H]
    for t in stale:
        print("  stale open task %s [%s] %s (%.0fh) — close it: relay end %s --status abandoned|blocked"
              % (t["id"], who(t), t.get("title", ""), age_h(t["ts"]), t["id"]))
    thin = [e for e in all_events() if e.get("type") == "end" and not e.get("verify")
            and e.get("status") == "done"]
    if thin:
        print("  %d 'done' task(s) closed without --verify" % len(thin))
    for ln in stats_lines():
        print("  " + ln)
    legacy = legacy_files()
    if legacy:
        print("legacy per-session files: %s (run 'relay migrate' to fold them into the day files)"
              % ", ".join(legacy))


# --------------------------------------------------------------------------- CLI
def add_list_arg(p, name, help_text):
    p.add_argument("--" + name, action="append", default=[], help=help_text)


def build_parser():
    p = argparse.ArgumentParser(prog="relay", description="Cross-agent work log.")
    p.add_argument("--version", action="version", version=VERSION)
    p.add_argument("--session", help="session id (else $RELAY_SESSION)")
    p.add_argument("--key", help="harness key mapped to a session (else $RELAY_KEY)")
    p.add_argument("--agent", help="agent name (else $RELAY_AGENT, else the session's own name)")
    p.add_argument("--model", default=os.environ.get("RELAY_MODEL", ""))

    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("start", help="open a task: what will be done and how")
    s.add_argument("title", help="one-line label (≤120 chars)")
    s.add_argument("--goal", default="", help="what and why (≤600 chars, multi-line ok)")
    add_list_arg(s, "plan", "one step of the plan (repeatable)")
    add_list_arg(s, "accept", "acceptance criteria / definition of done (repeatable)")
    add_list_arg(s, "out", "explicitly out of scope (repeatable)")
    s.add_argument("--scope", action="append", default=[], help="paths expected to be touched (repeatable, comma ok)")
    add_list_arg(s, "tags", "keywords to make the work findable (repeatable, comma ok)")
    add_list_arg(s, "refs", "codes/URLs: T-65, L-42, #123 (repeatable, comma ok)")

    n = sub.add_parser("note", help="log progress, a problem, a decision, a result, a blocker")
    n.add_argument("task", nargs="?", help="task id (default: the open task of this session)")
    n.add_argument("--kind", default="progress", choices=list(KINDS))
    n.add_argument("--text", required=True, help="what happened, one line (≤160 chars)")
    n.add_argument("--next", default="", help="the next step, one line (≤160 chars)")
    add_list_arg(n, "detail", "extra lines: error output, measurements, context (repeatable)")
    add_list_arg(n, "where", "where to look: file:line, service, endpoint (repeatable, comma ok)")
    add_list_arg(n, "refs", "codes/URLs (repeatable, comma ok)")

    sc = sub.add_parser("scope", help="log that the working scope changed")
    sc.add_argument("task", nargs="?", help="task id (default: the open task of this session)")
    sc.add_argument("--add", action="append", default=[], required=True,
                    help="paths added to the scope (repeatable, comma ok)")
    sc.add_argument("--why", default="", required=True, help="why the scope changed (≤300 chars)")

    w = sub.add_parser("wait", help="declare a long command before running it")
    w.add_argument("task", nargs="?", help="task id (default: the open task of this session)")
    w.add_argument("--eta", default="", help="estimated time: 8m, 90s, 1h30m (required above RELAY_MIN_DECLARE)")
    w.add_argument("--cmd", dest="cmd_text", default="", required=True, help="the command about to run")

    r = sub.add_parser("run", help="run a long command with timing, or record one")
    r.add_argument("--task", default=None, help="task id (default: the open task of this session)")
    r.add_argument("--eta", default="", help="estimated time: 8m, 90s, 1h30m")
    r.add_argument("--cmd", dest="cmd_text", default="", help="the command (required with --record or --)")
    r.add_argument("--record", action="store_true",
                   help="do not execute; only record a measurement taken by a hook")
    r.add_argument("--actual", default="", help="measured time with --record (e.g. 95s)")
    r.add_argument("--exit", default=0, type=int, help="exit code with --record")
    r.add_argument("command", nargs=argparse.REMAINDER, help="command to execute after --")

    e = sub.add_parser("end", help="close a task: what was done, problems, verification, next")
    e.add_argument("task", nargs="?", help="task id (default: the open task of this session)")
    e.add_argument("--status", default="done", choices=["done", "partial", "abandoned", "blocked"])
    e.add_argument("--summary", default="", help="dense summary of the outcome (≤1000 chars)")
    add_list_arg(e, "done", "a step that was actually completed (repeatable)")
    add_list_arg(e, "problem", "problem → resolution, or problem (UNRESOLVED) (repeatable)")
    add_list_arg(e, "verify", "how it was verified and the result (repeatable)")
    add_list_arg(e, "metric", "before → after (n=…, window=…) (repeatable)")
    e.add_argument("--changes", action="append", default=[], help="files/dirs changed (repeatable, comma ok)")
    add_list_arg(e, "commit", "commit sha (repeatable, comma ok)")
    add_list_arg(e, "next", "open item / next step (repeatable)")
    add_list_arg(e, "lesson", "lesson code, e.g. L-42 (repeatable, comma ok)")
    add_list_arg(e, "refs", "codes/URLs (repeatable, comma ok)")
    e.add_argument("--impact", default="", help="what the next person must know (≤600 chars)")
    e.add_argument("--force", action="store_true", help="close despite gate violations (recorded)")

    y = sub.add_parser("sync", help="print what other sessions did since your last sync")
    y.add_argument("--all", action="store_true", help="full history, do not advance the cursor")
    y.add_argument("--full", action="store_true", help="print fields in full, not compacted")
    y.add_argument("--task", help="only this task id")

    sh = sub.add_parser("show", help="print one task in full (all fields, all notes)")
    sh.add_argument("task", nargs="?", help="task id (default: the open task of this session)")
    sh.add_argument("--json", action="store_true", help="raw JSON events")

    mg = sub.add_parser("migrate", help="fold legacy per-session files into the day files")
    mg.add_argument("--dry-run", action="store_true", help="show what would move, write nothing")

    op = sub.add_parser("open", help="list open tasks of every session (stale ones flagged)")
    op.add_argument("--stale", action="store_true", help="only tasks older than RELAY_STALE_HOURS")

    bd = sub.add_parser("board", help="open tasks with now/next/scope-clash lines")

    tk = sub.add_parser("tick", help="rhythm check: at most one line, exit 2 on violation")
    tk.add_argument("--json", action="store_true", help="machine-readable result")
    tk.add_argument("--hook", action="store_true", help="same as tick (for hook commands)")

    gd = sub.add_parser("guard", help="hook guards")
    gd.add_argument("--stop", action="store_true", help="Claude Code Stop hook: block once when silent too long")

    sub.add_parser("stats", help="aggregate quality numbers over closed tasks")
    sub.add_parser("doctor", help="health check")
    sub.add_parser("version", help="print the version")
    return p


def pick_task(sid, args, allow_last=False, allow_session_last=False):
    """Find the task id to act on.

    Order: explicit id → open task of this session → single open task of this
    agent → the most recent task of this session (only for notes, so a
    correction can still be attached after the task was closed) → (only for
    read-only commands) the most recent task overall.
    """
    if getattr(args, "task", None):
        return args.task
    mine = session_events(sid)
    opn = open_tasks(mine)
    if opn:
        return opn[-1]["id"]
    agent = resolve_agent(sid, args)
    cands = []
    for fn in data_files():
        evs, _ = read_file(fn)
        for t in open_tasks(evs):
            join = next((e for e in evs if e.get("type") == "join"
                         and e.get("session") == t.get("session")), {})
            if join.get("agent") == agent:
                cands.append(t)
    if len(cands) == 1:
        return cands[0]["id"]
    if len(cands) > 1:
        print("[relay] nhiều việc đang dở của agent '%s', chọn rõ task id: %s"
              % (agent, ", ".join(t["id"] for t in cands)), file=sys.stderr)
        return None
    if allow_session_last:
        started = [e for e in mine if e.get("type") == "start"]
        if started:
            return started[-1]["id"]
    if allow_last:
        ids = [e.get("id") for e in all_events() if e.get("type") == "start"]
        if ids:
            return ids[-1]
    return None


def main():
    args = build_parser().parse_args()

    if args.cmd == "version":
        print(VERSION)
        return
    if args.cmd == "doctor":
        doctor()
        return
    if args.cmd == "open":
        open_report(args.stale)
        return
    if args.cmd == "board":
        board(existing_sid(args))
        return
    if args.cmd == "stats":
        stats()
        return
    if args.cmd == "tick":
        return tick(existing_sid(args), args.json or args.hook)
    if args.cmd == "guard":
        if args.stop:
            payload = {}
            try:
                if not sys.stdin.isatty():
                    raw = sys.stdin.read()
                    if raw.strip():
                        payload = json.loads(raw)
            except Exception:
                payload = {}
            return guard_stop(existing_sid(args), payload)
        print("[relay] guard needs --stop", file=sys.stderr)
        return 2
    if args.cmd == "migrate":
        report = migrate(args.dry_run)
        for line in report:
            print(line)
        print("dry run: nothing written" if args.dry_run else "migrated %d file(s)" % len(report))
        return

    # fold v1/v2 per-session files into the day files (kept in data/legacy/)
    if legacy_files():
        report = migrate()
        for line in report:
            print("[relay] migrated %s" % line, file=sys.stderr)

    sid, gen = session_id(args)
    read_only = args.cmd == "show"
    if read_only:
        # read-only commands must not create a stray session
        first = False
    else:
        first = ensure_join(sid, args)
    if gen:
        print("session=%s  (reuse: --session %s or RELAY_SESSION)" % (sid, sid))

    if args.cmd == "sync":
        sync(sid, args.all, first, args.full, args.task)
    elif args.cmd == "show":
        task = pick_task(sid, args, allow_last=True)
        if not task:
            print("[relay] không tìm thấy task; truyền rõ task id", file=sys.stderr)
            return
        start, notes, end, extras = find_task(task)
        render_task(start, notes, end, args.json, extras)
    elif args.cmd == "start":
        sync(sid, first=first)
        scope = flat(args.scope)
        ev = base(sid, args, "start")
        ev.update({
            "title": clip_text(args.title, TEXT_LIMITS["title"]) or "untitled",
            "goal": clip_text(args.goal, TEXT_LIMITS["goal"]),
            "plan": clip_list(args.plan, *LIST_LIMITS["plan"]),
            "accept": clip_list(args.accept, *LIST_LIMITS["accept"]),
            "outs": clip_list(args.out, *LIST_LIMITS["outs"]),
            "scope": clip_list(scope, *LIST_LIMITS["scope"]),
            "tags": clip_list(flat(args.tags), *LIST_LIMITS["tags"]),
            "refs": clip_list(flat(args.refs), *LIST_LIMITS["refs"]),
            "status": "planned",
        })
        clash = [t for t in open_tasks([e for e in all_events() if e.get("session") != sid])
                 if overlap(scope, t.get("scope", []))]
        append(sid, ev)
        warn_quality("start", ev)
        print("task=%s" % ev["id"])
        for t in clash:
            print("! scope overlaps open work [%s] %s: %s" % (who(t), t["id"], t.get("title", "")))
    elif args.cmd == "note":
        task = pick_task(sid, args, allow_session_last=True)
        if not task:
            print("[relay] không có task để ghi note; truyền rõ task id", file=sys.stderr)
            return
        ev = base(sid, args, "note")
        ev.update({
            "task": task,
            "kind": args.kind,
            "text": clip_text(args.text, 160),
            "next": clip_text(args.next, 160),
            "detail": clip_list(args.detail, *LIST_LIMITS["detail"]),
            "where": clip_list(flat(args.where), *LIST_LIMITS["where"]),
            "refs": clip_list(flat(args.refs), *LIST_LIMITS["refs"]),
        })
        append(sid, ev)
        print("note=%s task=%s" % (ev["id"], task))
    elif args.cmd == "scope":
        task = pick_task(sid, args, allow_session_last=True)
        if not task:
            print("[relay] không có task để ghi scope; truyền rõ task id", file=sys.stderr)
            return
        add = clip_list(flat(args.add), *LIST_LIMITS["add"])
        ev = base(sid, args, "scope")
        ev.update({"task": task, "add": add, "why": clip_text(args.why, 300)})
        append(sid, ev)
        print("scope=%s task=%s +%s" % (ev["id"], task, ", ".join(add)))
    elif args.cmd == "wait":
        task = pick_task(sid, args, allow_session_last=True)
        if not task:
            print("[relay] không có task để ghi wait; truyền rõ task id", file=sys.stderr)
            return
        ev = base(sid, args, "wait")
        ev.update({"task": task, "cmd": clip_text(args.cmd_text, 300),
                   "eta_s": parse_dur(args.eta) or 0})
        append(sid, ev)
        print("wait=%s task=%s eta=%s cmd=%s"
              % (ev["id"], task, fmt_duration(ev["eta_s"]) or "?", ev["cmd"]))
    elif args.cmd == "run":
        task = pick_task(sid, args, allow_session_last=True)
        if not task:
            print("[relay] không có task để ghi run; truyền rõ task id", file=sys.stderr)
            return
        if args.record:
            cmd = args.cmd_text or " ".join(args.command).lstrip("- ").strip()
            if not cmd:
                print("[relay] run --record cần --cmd", file=sys.stderr)
                return 2
            actual = parse_dur(args.actual)
            if actual is None:
                print("[relay] run --record cần --actual <thời gian đo được>", file=sys.stderr)
                return 2
            eta = parse_dur(args.eta) or 0
            late, over = run_late_over(eta, actual)
            ev = base(sid, args, "run")
            ev.update({"task": task, "cmd": clip_text(cmd, 300), "eta_s": eta,
                       "actual_s": actual, "exit": args.exit,
                       "late_s": late, "over_s": over})
            append(sid, ev)
            print("run=%s task=%s %s (eta %s) exit %d%s"
                  % (ev["id"], task, fmt_duration(actual), fmt_duration(eta) or "?",
                     args.exit, " LATE +%ds" % late if late else ""))
            return 0
        cmd = [c for c in (args.command or [])]
        if cmd and cmd[0] == "--":
            cmd = cmd[1:]
        if not cmd and not args.cmd_text:
            print("[relay] run cần lệnh: relay run -- <lệnh>  (hoặc --record)", file=sys.stderr)
            return 2
        if not cmd:
            import shlex
            cmd = shlex.split(args.cmd_text)
        eta = parse_dur(args.eta) or 0
        w = base(sid, args, "wait")
        w.update({"task": task, "cmd": clip_text(" ".join(cmd), 300), "eta_s": eta})
        append(sid, w)
        t0 = time.time()
        try:
            proc = subprocess.run(cmd)
            rc = proc.returncode
        except FileNotFoundError:
            print("[relay] không chạy được: %s" % cmd[0], file=sys.stderr)
            return 127
        actual = int(time.time() - t0)
        late, over = run_late_over(eta, actual)
        ev = base(sid, args, "run")
        ev.update({"task": task, "cmd": clip_text(" ".join(cmd), 300), "eta_s": eta,
                   "actual_s": actual, "exit": rc, "late_s": late, "over_s": over})
        append(sid, ev)
        print("run=%s task=%s %s (eta %s) exit %d%s"
              % (ev["id"], task, fmt_duration(actual), fmt_duration(eta) or "?",
                 rc, " LATE +%ds" % late if late else ""))
        return rc
    elif args.cmd == "end":
        task = pick_task(sid, args)
        reclose = False
        if not task and args.force:
            # accept the penalty on the session's latest gate-failed close
            started = [e for e in session_events(sid) if e.get("type") == "start"]
            for s in reversed(started):
                _st, _no, en, _ex = find_task(s["id"])
                if en and en.get("gate") and not en.get("forced"):
                    task = s["id"]
                    reclose = True
                    break
        if not task:
            print("[relay] không có việc đang dở để kết thúc", file=sys.stderr)
            return
        start, notes, _end, _ex = find_task(task)
        duration = 0
        if start:
            try:
                t0 = datetime.strptime(start["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
                duration = int((datetime.now(timezone.utc) - t0).total_seconds())
            except (KeyError, ValueError):
                duration = 0
        changes = clip_list(flat(args.changes), *LIST_LIMITS["changes"])
        verify = clip_list(args.verify, *LIST_LIMITS["verify"])
        gate, _tm, drift = end_gate(task, start, changes, args.status)
        if args.status == "done" and not verify:
            gate.append("done nhưng thiếu --verify")
        forced = bool(args.force and (gate or reclose))
        ev = base(sid, args, "end")
        ev.update({
            "task": task,
            "status": args.status,
            "summary": clip_text(args.summary, TEXT_LIMITS["summary"]),
            "done": clip_list(args.done, *LIST_LIMITS["done"]),
            "problems": clip_list(args.problem, *LIST_LIMITS["problems"]),
            "verify": verify,
            "metrics": clip_list(args.metric, *LIST_LIMITS["metrics"]),
            "changes": changes,
            "commits": clip_list(flat(args.commit), *LIST_LIMITS["commits"]),
            "impact": clip_text(args.impact, TEXT_LIMITS["impact"]),
            "next": clip_list(args.next, *LIST_LIMITS["next"]),
            "lessons": clip_list(flat(args.lesson), *LIST_LIMITS["lessons"]),
            "refs": clip_list(flat(args.refs), *LIST_LIMITS["refs"]),
            "duration_s": duration,
            "notes": len(notes),
            "gate": gate,
            "forced": forced,
        })
        sc = task_score(task, start, ev, changes, forced)
        ev.update({"score": sc["score"], "cadence": sc["cadence"], "scope_pts": sc["scope"],
                   "close_pts": sc["close"], "open_pts": sc["open"],
                   "silence_max_s": sc["silence_max_s"], "overdue_s": sc["overdue_s"],
                   "wait_s": sc["wait_s"], "late_s": sc["late_s"],
                   "scope_drift": sc["scope_drift"]})
        append(sid, ev)
        if gate and not forced:
            print("ended=%s status=%s duration=%s notes=%d score=%d"
                  % (task, ev["status"], fmt_duration(duration), len(notes), sc["score"]))
            print("GATE: %s" % "; ".join(gate), file=sys.stderr)
            print("task đã đóng với điểm %d. Chạy lại với --force để chấp nhận phạt."
                  % sc["score"], file=sys.stderr)
            return 1
        if forced:
            print("ended=%s status=%s duration=%s notes=%d score=%d forced=true"
                  % (task, ev["status"], fmt_duration(duration), len(notes), sc["score"]))
        else:
            print("ended=%s status=%s duration=%s notes=%d score=%d"
                  % (task, ev["status"], fmt_duration(duration), len(notes), sc["score"]))
        sync(sid)
        return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main() or 0)
    except SystemExit:
        raise
    except Exception as ex:  # logging must never block the main work
        print("[relay] error: %s" % ex, file=sys.stderr)
