def task_now_next(task_id):
    """(now_text, next_text) from the latest activity of a task."""
    rel = task_related(task_id)
    start = next((e for e in rel if e.get("type") == "start"), None)
    now_txt = (start or {}).get("title", "?")
    next_txt = None
    for e in reversed(rel):
        typ = e.get("type")
        if typ == "note":
            if now_txt == (start or {}).get("title", "?") or True:
                if e.get("text"):
                    now_txt = one(e["text"], 100)
            if e.get("next") and next_txt is None:
                next_txt = one(e["next"], 100)
            break
        if typ == "run":
            now_txt = "run xong: %s (%s, exit %s)" % (
                one(e.get("cmd", ""), 60), fmt_duration(e.get("actual_s")),
                e.get("exit", "?"))
            break
        if typ == "scope":
            now_txt = "mở rộng scope: %s" % ", ".join((e.get("add") or [])[:3])
            break
        if typ == "wait":
            eta = fmt_duration(e.get("eta_s")) or "?"
            now_txt = "đang chờ: %s (eta %s)" % (one(e.get("cmd", ""), 60), eta)
            break
    if next_txt is None:
        for e in reversed(rel):
            if e.get("type") == "note" and e.get("next"):
                next_txt = one(e["next"], 100)
                break
    return now_txt, next_txt or "—"


def board_lines(sid=None, limit=10, only_others=False):
    """One line per open task: now · next · scope clash. For board and sync."""
    mine_scope = []
    if sid:
        mine = session_events(sid)
        mine_scope = [s for t in open_tasks(mine) for s in t.get("scope", [])]
    closed = {e.get("task") for e in all_events() if e.get("type") == "end"}
    rows, seen = [], set()
    for e in all_events():
        if e.get("type") == "start" and e["id"] not in closed and e["id"] not in seen:
            seen.add(e["id"])
            rows.append(e)
    rows.sort(key=lambda e: e.get("ts", ""))
    out = []
    for t in rows:
        if only_others and sid and t.get("session") == sid:
            continue
        if len(out) >= limit:
            break
        now_txt, next_txt = task_now_next(t["id"])
        scopes = [e for e in task_related(t["id"]) if e.get("type") == "scope"]
        clash = ""
        if sid and t.get("session") != sid and mine_scope:
            if overlap(mine_scope, effective_scope(t, scopes)):
                clash = "  ⚠ trùng scope với bạn"
        age = age_h(t["ts"])
        stale = "  (idle %.0fh)" % age if age > STALE_H else ""
        out.append("▶ %s [%s] %s — now: %s — next: %s%s%s"
                   % (t["id"], who(t), t.get("title", ""), now_txt, next_txt,
                      clash, stale))
    return out


def board(sid=None):
    lines = board_lines(sid)
    if not lines:
        print("không có task nào đang mở")
        return
    print("board — %d task đang mở:" % len(lines))
    for ln in lines:
        print("  " + ln)


def peek_unread(sid):
    """Count unread start/note/end/scope/run events from other sessions."""
    cur = load_cursor(sid)
    n, by_agent = 0, {}
    for fn in data_files():
        evs, _off = read_file(fn, cur.get(fn, 0))
        for e in evs:
            if e.get("type") in ("start", "note", "end", "scope", "run") \
                    and e.get("session") != sid:
                n += 1
                by_agent[e.get("agent", "?")] = by_agent.get(e.get("agent", "?"), 0) + 1
    return n, by_agent


def tick(sid=None, as_json=False):
    """One-line rhythm/scope/coordination check. Exit 2 on violation, else 0.

    Never blocks, never writes. Order: no-task-with-changes → expired wait →
    silence overdue → scope drift → unread news → silence.
    """
    now_dt = datetime.now(timezone.utc)
    result = {"ok": True, "messages": [], "unread": 0, "silence_s": 0,
              "drift": [], "exit": 0}

    def emit(msg, violation):
        result["messages"].append(msg)
        if violation:
            result["ok"] = False
            result["exit"] = 2

    if sid is None:
        stale = [t for t in board_lines(None) if "(idle" in t]
        if stale:
            emit("relay: %d task mở quá %dh chưa ai đóng — relay open --stale" % (len(stale), int(STALE_H)), False)
        if as_json:
            print(json.dumps(result, ensure_ascii=False))
        else:
            for m in result["messages"]:
                print(m)
        return result["exit"]

    mine = session_events(sid)
    opn = open_tasks(mine)
    if not opn:
        if git_modified():
            emit("relay: repo có thay đổi nhưng chưa có task mở — relay start \"…\" --scope <path>", True)
        n, _by = peek_unread(sid)
        result["unread"] = n
        if n:
            emit("relay: %d sự kiện mới từ phiên khác — relay sync" % n, False)
        if as_json:
            print(json.dumps(result, ensure_ascii=False))
        else:
            for m in result["messages"]:
                print(m)
        return result["exit"]

    task = opn[-1]
    tm = task_timing(task["id"], task, None, now_dt)
    result["silence_s"] = tm["silence_max_s"]
    modified = git_modified()
    drift = outside_scope(modified, tm["scope"]) if tm["scope"] else []
    result["drift"] = drift
    if tm["open_wait"]:
        eta = int(tm["open_wait"].get("eta_s") or 0)
        wt = parse_ts(tm["open_wait"].get("ts"))
        elapsed = int((now_dt - wt).total_seconds()) if wt else 0
        window = max(2 * eta, MIN_DECLARE) if eta > 0 else MIN_DECLARE
        if elapsed > window:
            emit("relay: chờ quá 2×eta (%s quá %s) mà chưa có run — ước tính sai hoặc lệnh treo"
                 % (fmt_duration(elapsed), fmt_duration(window)), True)
    if tm["silence_max_s"] > GAP_MAX:
        emit("relay: %s chưa ghi (task %s) — relay note --kind progress --text \"…\" --next \"…\""
             % (fmt_duration(tm["silence_max_s"]), task["id"]), True)
    elif tm["silence_max_s"] > NUDGE_AFTER:
        emit("relay: đã im %s (task %s, hạn %s) — ghi 1 dòng note"
             % (fmt_duration(tm["silence_max_s"]), task["id"], fmt_duration(GAP_MAX)), False)
    if drift:
        emit("relay: %d file ngoài scope (%s) — relay scope --add <path> --why \"…\""
             % (len(drift), ", ".join(drift[:3])), True)
    n, _by = peek_unread(sid)
    result["unread"] = n
    if n:
        emit("relay: %d sự kiện mới từ phiên khác — relay sync" % n, False)
    if as_json:
        print(json.dumps(result, ensure_ascii=False))
    else:
        for m in result["messages"]:
            print(m)
    return result["exit"]


def guard_stop(sid, payload):
    """Claude Code Stop hook: block once when the agent would leave silently."""
    if isinstance(payload, dict) and payload.get("stop_hook_active"):
        return 0
    if not sid:
        return 0
    mine = session_events(sid)
    opn = open_tasks(mine)
    if not opn:
        return 0
    task = opn[-1]
    tm = task_timing(task["id"], task, None)
    if tm["silence_max_s"] <= GAP_MAX:
        return 0
    print("relay: task %s im lặng %dm (hạn %dm). Ghi 1 dòng rồi hãy kết thúc:\n"
          "  relay --session %s note --kind progress --text \"…\" --next \"…\""
          % (task["id"], tm["silence_max_s"] // 60, int(GAP_MAX // 60), sid))
    return 2


def stats_lines():
    """Aggregate quality numbers over all closed tasks."""
    starts = [e for e in all_events() if e.get("type") == "start"]
    ends = {e.get("task"): e for e in all_events() if e.get("type") == "end"}
    closed = [(s, ends[s["id"]]) for s in starts if s["id"] in ends]
    lines = ["tasks: %d (%d đang mở)" % (len(starts), len(starts) - len(closed))]
    if not closed:
        return lines
    scores, silences, notes_n, fails, forced_n = [], [], [], 0, 0
    by_agent = {}
    for s, e in closed:
        sc = task_score(s["id"], s, e, forced=bool(e.get("forced")))
        scores.append(sc["score"])
        silences.append(sc["silence_max_s"])
        notes_n.append(sc["notes"])
        if e.get("gate"):
            fails += 1
        if e.get("forced"):
            forced_n += 1
        by_agent.setdefault(s.get("agent", "?"), []).append(sc["score"])
    notes_n.sort()
    lines.append("score TB: %d · note/task (median): %d · im lặng max: %s"
                 % (sum(scores) // len(scores), notes_n[len(notes_n) // 2],
                    fmt_duration(max(silences))))
    lines.append("gate fail: %d · forced: %d · done thiếu verify: %d"
                 % (fails, forced_n,
                    sum(1 for _s, e in closed if e.get("status") == "done" and not e.get("verify"))))
    for agent, ss in sorted(by_agent.items()):
        lines.append("  %s: %d (n=%d)" % (agent, sum(ss) // len(ss), len(ss)))
    return lines


def stats():
    for ln in stats_lines():
        print(ln)


